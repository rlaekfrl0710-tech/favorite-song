/** My 노래방 전용. 코난 프로젝트/시트/설정에 접근하지 않습니다. */
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('My 노래방').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');}
function karaokeSheet_(){var props=PropertiesService.getScriptProperties(),id=props.getProperty('KARAOKE_SHEET_ID'),book;if(id){book=SpreadsheetApp.openById(id);}else{book=SpreadsheetApp.create('My 노래방 DB');props.setProperty('KARAOKE_SHEET_ID',book.getId());book.getSheets()[0].setName('Songs');book.getSheets()[0].appendRow(['ID','Version','Deleted','Song JSON','Updated at']);var history=book.insertSheet('History');history.appendRow(['ID','Version','Deleted','Song JSON','Updated at']);}return book;}
function karaokeRows_(book){var sheet=book.getSheetByName('Songs'),rows=sheet.getDataRange().getValues(),records={};for(var i=1;i<rows.length;i++){if(!rows[i][0])continue;records[String(rows[i][0])]={version:Number(rows[i][1])||0,deleted:rows[i][2]===true,song:rows[i][3]?JSON.parse(rows[i][3]):null,row:i+1};}return records;}
function karaokePublic_(records){var out={};Object.keys(records).forEach(function(id){var r=records[id];out[id]={version:r.version,deleted:r.deleted,song:r.deleted?null:r.song};});return out;}
function karaokeRead(){var lock=LockService.getScriptLock();lock.waitLock(20000);try{return {records:karaokePublic_(karaokeRows_(karaokeSheet_()))};}finally{lock.releaseLock();}}
function karaokeWrite(payload){if(!payload||!payload.changes||typeof payload.changes!=='object')throw Error('올바르지 않은 저장 요청');var ids=Object.keys(payload.changes);if(ids.length>2000)throw Error('한 번에 저장할 곡이 너무 많아요');var lock=LockService.getScriptLock();lock.waitLock(20000);try{var book=karaokeSheet_(),sheet=book.getSheetByName('Songs'),history=book.getSheetByName('History'),records=karaokeRows_(book),result={},conflict=false;ids.forEach(function(id){if(!/^\d+$/.test(id))throw Error('올바르지 않은 곡 ID');var change=payload.changes[id],old=records[id];if(Number(change.version||0)!==Number(old&&old.version||0)){if(old)result[id]=old;conflict=true;return;}var song=change.deleted?(old&&old.song||null):change.song;if(!change.deleted&&(!song||String(song.id)!==id||typeof song.title!=='string'||typeof song.artist!=='string'))throw Error('곡 정보를 확인해 주세요');var json=JSON.stringify(song);if(json.length>45000)throw Error('가사가 너무 길어요');var version=(old&&old.version||0)+1,row=[id,version,!!change.deleted,json,new Date().toISOString()];if(old)history.appendRow([id,old.version,old.deleted,JSON.stringify(old.song),row[4]]);if(old)sheet.getRange(old.row,1,1,5).setValues([row]);else sheet.appendRow(row);records[id]={version:version,deleted:!!change.deleted,song:song,row:old?old.row:sheet.getLastRow()};result[id]=records[id];});return {records:karaokePublic_(result),conflict:conflict};}finally{lock.releaseLock();}}
