/** My 노래방 전용. 코난 프로젝트/시트/설정에 접근하지 않습니다. */
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('My 노래방').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');}
function karaokeSheet_(){var props=PropertiesService.getScriptProperties(),id=props.getProperty('MY_APPS_SHEET_ID');if(!id)throw Error('마이앱 스프레드시트 ID를 먼저 설정해 주세요.');var book=SpreadsheetApp.openById(id);if(!book.getSheetByName('노래방')){var sheet=book.insertSheet('노래방');sheet.appendRow(['ID','Version','Deleted','Song JSON','Updated at']);sheet.setFrozenRows(1);}if(!book.getSheetByName('노래방_기록')){book.insertSheet('노래방_기록').appendRow(['ID','Version','Deleted','Song JSON','Updated at']);}return book;}
function karaokeRows_(book){var sheet=book.getSheetByName('노래방'),rows=sheet.getDataRange().getValues(),records={};for(var i=1;i<rows.length;i++){if(!rows[i][0])continue;records[String(rows[i][0])]={version:Number(rows[i][1])||0,deleted:rows[i][2]===true,song:rows[i][3]?JSON.parse(rows[i][3]):null,row:i+1};}return records;}
function karaokePublic_(records){var out={};Object.keys(records).forEach(function(id){var r=records[id];out[id]={version:r.version,deleted:r.deleted,song:r.deleted?null:r.song};});return out;}
function karaokeRead(token){karaokeRequire_(token);var lock=LockService.getScriptLock();lock.waitLock(20000);try{return {records:karaokePublic_(karaokeRows_(karaokeSheet_()))};}finally{lock.releaseLock();}}
function karaokeWrite(payload,token){karaokeRequire_(token);if(!payload||!payload.changes||typeof payload.changes!=='object')throw Error('올바르지 않은 저장 요청');var ids=Object.keys(payload.changes);if(ids.length>2000)throw Error('한 번에 저장할 곡이 너무 많아요');var lock=LockService.getScriptLock();lock.waitLock(20000);try{var book=karaokeSheet_(),sheet=book.getSheetByName('노래방'),history=book.getSheetByName('노래방_기록'),records=karaokeRows_(book),result={},conflict=false;ids.forEach(function(id){if(!/^\d+$/.test(id))throw Error('올바르지 않은 곡 ID');var change=payload.changes[id],old=records[id];if(Number(change.version||0)!==Number(old&&old.version||0)){if(old)result[id]=old;conflict=true;return;}var song=change.deleted?(old&&old.song||null):change.song;if(!change.deleted&&(!song||String(song.id)!==id||typeof song.title!=='string'||typeof song.artist!=='string'))throw Error('곡 정보를 확인해 주세요');var json=JSON.stringify(song);if(json.length>45000)throw Error('가사가 너무 길어요');var version=(old&&old.version||0)+1,row=[id,version,!!change.deleted,json,new Date().toISOString()];if(old)history.appendRow([id,old.version,old.deleted,JSON.stringify(old.song),row[4]]);if(old)sheet.getRange(old.row,1,1,5).setValues([row]);else sheet.appendRow(row);records[id]={version:version,deleted:!!change.deleted,song:song,row:old?old.row:sheet.getLastRow()};result[id]=records[id];});return {records:karaokePublic_(result),conflict:conflict};}finally{lock.releaseLock();}}

// 비밀번호와 세션은 서버 속성에만 보관합니다.
function karaokeDigest_(value){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8));}
function karaokePasswordHash_(password,salt){var result=salt+password;for(var i=0;i<10000;i++)result=karaokeDigest_(result+salt);return result;}
function karaokeOwner_(){var active=Session.getActiveUser().getEmail();return !!active&&active===Session.getEffectiveUser().getEmail();}
function karaokeAuthStatus(){return {configured:!!PropertiesService.getScriptProperties().getProperty('KARAOKE_PASSWORD_HASH'),canSetup:karaokeOwner_()};}
function karaokeSetup(password){if(!karaokeOwner_())throw Error('소유자 계정에서만 설정할 수 있어요');if(typeof password!=='string'||password.length<6||password.length>128)throw Error('비밀번호는 6~128자로 입력해 주세요');var lock=LockService.getScriptLock();lock.waitLock(20000);try{var p=PropertiesService.getScriptProperties();if(p.getProperty('KARAOKE_PASSWORD_HASH'))throw Error('이미 비밀번호가 설정되어 있어요');var salt=Utilities.getUuid();p.setProperties({KARAOKE_PASSWORD_SALT:salt,KARAOKE_PASSWORD_HASH:karaokePasswordHash_(password,salt)});return {ok:true};}finally{lock.releaseLock();}}
function karaokeLogin(password){var lock=LockService.getScriptLock();lock.waitLock(20000);try{var p=PropertiesService.getScriptProperties(),now=Date.now(),attempt=JSON.parse(p.getProperty('KARAOKE_LOGIN_ATTEMPTS')||'{}');if(now-Number(attempt.start||0)>300000)attempt={start:now,count:0};if(attempt.count>=10)throw Error('잠시 후 다시 시도해 주세요 (5분)');var expected=p.getProperty('KARAOKE_PASSWORD_HASH');if(!expected)throw Error('소유자의 비밀번호 설정이 필요해요');if(typeof password!=='string'||password.length>128||karaokePasswordHash_(password,p.getProperty('KARAOKE_PASSWORD_SALT'))!==expected){attempt.count++;p.setProperty('KARAOKE_LOGIN_ATTEMPTS',JSON.stringify(attempt));throw Error('비밀번호를 확인해 주세요');}p.deleteProperty('KARAOKE_LOGIN_ATTEMPTS');var sessions=JSON.parse(p.getProperty('KARAOKE_SESSIONS')||'{}');Object.keys(sessions).forEach(function(k){if(sessions[k]<now)delete sessions[k];});if(Object.keys(sessions).length>=100)throw Error('로그인 기기가 너무 많아요');var token=Utilities.getUuid()+Utilities.getUuid();sessions[karaokeDigest_(token)]=now+90*86400000;p.setProperty('KARAOKE_SESSIONS',JSON.stringify(sessions));return {token:token};}finally{lock.releaseLock();}}
function karaokeRequire_(token){var sessions=JSON.parse(PropertiesService.getScriptProperties().getProperty('KARAOKE_SESSIONS')||'{}');if(typeof token!=='string'||!sessions[karaokeDigest_(token)]||sessions[karaokeDigest_(token)]<Date.now())throw Error('AUTH_REQUIRED');}
function karaokeSession(token){karaokeRequire_(token);return {ok:true};}
function karaokeLogout(token){var lock=LockService.getScriptLock();lock.waitLock(20000);try{var p=PropertiesService.getScriptProperties(),sessions=JSON.parse(p.getProperty('KARAOKE_SESSIONS')||'{}');if(typeof token==='string')delete sessions[karaokeDigest_(token)];p.setProperty('KARAOKE_SESSIONS',JSON.stringify(sessions));return {ok:true};}finally{lock.releaseLock();}}

// Vercel 경유 요청. 최초 비밀번호 설정은 Google 소유자 화면에서만 가능합니다.
function doPost(e){var result;try{if(!e||!e.postData||e.postData.contents.length>4000000)throw Error('잘못된 요청');var body=JSON.parse(e.postData.contents),data;switch(body.action){case 'status':data={configured:!!PropertiesService.getScriptProperties().getProperty('KARAOKE_PASSWORD_HASH')};break;case 'login':data=karaokeLogin(body.password);break;case 'session':data=karaokeSession(body.token);break;case 'read':data=karaokeRead(body.token);break;case 'write':data=karaokeWrite(body.payload,body.token);break;case 'logout':data=karaokeLogout(body.token);break;default:throw Error('지원하지 않는 요청');}result={ok:true,data:data};}catch(error){result={ok:false,error:String(error.message||'처리 실패')};}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);}
